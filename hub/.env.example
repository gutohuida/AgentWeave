# AgentWeave Hub — environment configuration
# Copy this file to .env and adjust values as needed.

# SQLite database path (default: data/agentweave.db inside the container)
DATABASE_URL=sqlite+aiosqlite:///data/agentweave.db

# Port the Hub listens on (default: 8000)
AW_PORT=8000

# Bootstrap credentials — OPTIONAL.
# If left empty or set to the placeholder below, the Hub auto-generates a secure key on first startup.
# The CLI fetches this key automatically via `agentweave hub start` or `agentweave activate`.
# You only need to set this manually if you want a specific key value.
#
# To generate a key manually:
#   python -c "import secrets; print('aw_live_' + secrets.token_hex(16))"
#
# AW_BOOTSTRAP_API_KEY=aw_live_a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6

# Legacy bootstrap project — LEAVE UNSET for a fresh install.
# A fresh Hub starts with zero projects; open or create them from the dashboard
# or by invoking `agentweave` inside a project directory. These two variables
# exist only so a pre-multi-project installation keeps its existing project.
# AW_BOOTSTRAP_PROJECT_ID=proj-default
# AW_BOOTSTRAP_PROJECT_NAME=Default Project

# Workspace root — Docker only.
# Host directory holding your projects. It is mounted at /workspaces inside the
# container, and the Hub accepts project registrations only beneath that root
# (AW_WORKSPACE_ROOT is set to /workspaces by docker-compose.yml).
# Default when unset: ./workspaces next to docker-compose.yml.
# AW_WORKSPACE_HOST_ROOT=/path/to/your/projects

# CORS allowed origins (comma-separated). Leave empty for same-origin only.
# Example for local dev with Vite: AW_CORS_ORIGINS=http://localhost:5173
AW_CORS_ORIGINS=
