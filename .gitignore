hub/data/

# Claude Code lock files
.claude/scheduled_tasks.lock

# Generated project skills. AgentWeave dogfoods itself: `agentweave init` renders
# src/agentweave/templates/skills/<name>.md into .claude/skills/<name>/SKILL.md with
# this project's agent names substituted in. They are build output — committing them
# means every template edit needs a matching regenerated commit, and in practice the
# copies silently drifted several releases behind the templates.
#
# Only template-derived names are listed. .claude/skills/ ALSO holds hand-written
# skills with no template (aw-deploy, aw-jobs, check-build, copilot-test-setup,
# openspec-*) which must stay tracked — do not replace this with `.claude/skills/`.
#
# Regenerate this list after adding a skill template:
#   for t in src/agentweave/templates/skills/*.md; do echo ".claude/skills/$(basename "$t" .md)/"; done
.claude/skills/aw-checkpoint/
.claude/skills/aw-collab-start/
.claude/skills/aw-delegate/
.claude/skills/aw-done/
.claude/skills/aw-relay/
.claude/skills/aw-review/
.claude/skills/aw-revise/
.claude/skills/aw-setup-agent/
.claude/skills/aw-setup-hub/
.claude/skills/aw-setup-proxy/
.claude/skills/aw-setup-roles/
.claude/skills/aw-setup-security/
.claude/skills/aw-setup-transport/
.claude/skills/aw-setup/
.claude/skills/aw-spec-apply/
.claude/skills/aw-spec-archive/
.claude/skills/aw-spec-explore/
.claude/skills/aw-spec-propose/
.claude/skills/aw-spec-technical-explore/
.claude/skills/aw-status/
.claude/skills/aw-sync/
.claude/skills/aw-verify/

